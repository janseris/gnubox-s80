// nettest.rss - NetTest for Series 80

NAME NTST

#include <eikon.rh>
#include <eikon.rsg>
#include <uikon.hrh>
#include "nettest.hrh"

RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF { buf = ""; }

RESOURCE EIK_APP_INFO
	{
	menubar = r_nettest_menubar;
	cba = r_nettest_cba;
	}

RESOURCE CBA r_nettest_cba
	{
	buttons =
		{
		CBA_BUTTON { id = ENtCmdFull; txt = "Full test"; },
		CBA_BUTTON { id = ENtCmdSmall; txt = "Small files"; },
		CBA_BUTTON { id = ENtCmdStop; txt = "Stop"; },
		CBA_BUTTON { id = EEikCmdExit; txt = "Exit"; }
		};
	}

RESOURCE MENU_BAR r_nettest_menubar
	{
	titles =
		{
		MENU_TITLE { menu_pane = r_nettest_menu; txt = "Test"; }
		};
	}

RESOURCE MENU_PANE r_nettest_menu
	{
	items =
		{
		MENU_ITEM { command = ENtCmdFull; txt = "Full test (8 runs, all 118 files)"; },
		MENU_ITEM { command = ENtCmdQuick; txt = "Quick test (8 runs, 40 files)"; },
		MENU_ITEM { command = ENtCmdSmall; txt = "Small files (5 runs, 2-50 KB)"; },
		MENU_ITEM { command = ENtCmdUpload; txt = "Upload test (8 POSTs of 40 KB)"; },
		MENU_ITEM { command = ENtCmdStop; txt = "Stop"; },
		MENU_ITEM { command = ENtCmdSend; txt = "Send results to the PC again"; },
		MENU_ITEM { command = ENtCmdClear; txt = "Clear the screen"; flags = EEikMenuItemSeparatorAfter; },
		MENU_ITEM { command = EEikCmdExit; txt = "Exit"; }
		};
	}
